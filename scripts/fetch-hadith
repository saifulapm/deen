#!/usr/bin/env bash
# Build deen's hadith corpus into a directory. Run once — the nine books have
# not changed in eleven centuries.
#
#   scripts/fetch-hadith ~/.local/share/deen/hadith
#
# A DIRECTORY AND NOT STDOUT, unlike fetch-data and fetch-duas, and the reason
# is size: this is 118 MB across ten collections in three languages, and search
# has to reach it without parsing it. Each collection lands as JSONL — one
# hadith per line — so a query streams the bytes and parses only the lines that
# matched. No index, no offsets, nothing to invalidate.
#
# THE CONTENT IS SOMEBODY ELSE'S AND SO IS THE GRADING. Every hadith is stored
# with its collection, its number, and every grader's verdict under that
# grader's name — never collapsed into one word, because the graders disagree:
# in Abu Dawud the same narration is `Hasan Sahih` to Al-Albani and
# `Isnaad Hasan` to Zubair Ali Zai, and picking one of those for the reader
# would be this repo taking a scholarly position it has no standing to take.
#
# The numbering is sunnah.com's, which was checked against data this project
# already ships: Hisn al-Muslim cites "Al-Bukhari 5010" for Ayat al-Kursi, and
# 5010 here is that narration. So every hadith can be verified in one click at
# sunnah.com/<collection>:<number>, which is worth more than a second scraped
# copy to compare against — any second copy is scraped from sunnah.com too, and
# would prove the transport rather than the transmission.
set -euo pipefail

out=${1:?usage: fetch-hadith <output directory>}

# Pinned to a commit, not to the `1` branch it is normally served from: the
# file names are positions in someone else's repo and the numbering is the join
# key for three languages.
SHA=df57907be35291c91ad6a6691180e22ca9920784
BASE="https://cdn.jsdelivr.net/gh/fawazahmed0/hadith-api@$SHA/editions"

# Ten collections. Bengali exists for eight of them and is the reason this
# dataset was chosen over the alternatives — the Duas screen has no Bangla at
# all and there is nothing to be done about that; here there is.
COLLECTIONS="bukhari muslim abudawud tirmidhi nasai ibnmajah malik nawawi qudsi dehlawi"

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
mkdir -p "$out"

for c in $COLLECTIONS; do
  # A FAILED ARABIC OR ENGLISH FETCH IS FATAL. The first version tolerated all
  # three alike, and a single transient 500 from the CDN silently dropped the
  # whole of Jami' at-Tirmidhi — one of the six canonical books — leaving an
  # install that looked complete and answered searches from nine collections
  # instead of ten. Nobody would have noticed by reading the output.
  for lang in ara eng; do
    curl -fsSL --retry 3 --retry-delay 2 --max-time 600 \
      -o "$tmp/$lang-$c.json" "$BASE/$lang-$c.min.json" || {
      echo "fetch-hadith: could not fetch $lang-$c — refusing to install a partial corpus" >&2
      exit 1
    }
  done
  # Bengali is genuinely absent for two collections, so a 404 here is data
  # rather than a failure: those two get no Bangla column.
  curl -fsSL --retry 3 --retry-delay 2 --max-time 600 \
    -o "$tmp/ben-$c.json" "$BASE/ben-$c.min.json" || true
done

python3 - "$tmp" "$out" "$SHA" "$COLLECTIONS" <<'PY'
import json, os, re, sys

tmp, out, sha, collections = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4].split()

BENGALI = re.compile("[ঀ-৿]")

def load(lang, c):
    path = f"{tmp}/{lang}-{c}.json"
    if not os.path.exists(path) or os.path.getsize(path) == 0:
        return None
    return json.load(open(path, encoding="utf-8"))

def key(h):
    # The number is a STRING because a few are fractional (402.2), the same way
    # a dua id is a string because a few are lettered (75a). It is a citation,
    # not an index, and parsing it as a number loses the ones that matter.
    n = h.get("hadithnumber")
    return ("%s" % n).rstrip("0").rstrip(".") if isinstance(n, float) and n.is_integer() else str(n)

def number_order(k):
    """File order is the book's order, so a reader scrolling a collection is
    walking it rather than reading a hash. `402.2` sorts after `402`."""
    try:
        return (0, float(k), "")
    except ValueError:
        return (1, 0.0, k)

manifest = []
for c in collections:
    ar, en, bn = load("ara", c), load("eng", c), load("ben", c)
    if ar is None or en is None:
        # Unreachable now that the fetch is fatal, and kept as the belt to that
        # brace: a skipped collection must never be a warning nobody reads.
        print(f"fetch-hadith: {c} is missing its Arabic or English edition", file=sys.stderr)
        sys.exit(1)

    A = {key(h): h for h in ar["hadiths"]}
    E = {key(h): h for h in en["hadiths"]}
    if set(A) != set(E):
        # THE JOIN KEY HAS TO BE THE SAME KEY. Two editions that disagree about
        # which numbers exist would pair an Arabic hadith with somebody else's
        # translation, and nothing downstream could tell.
        print(f"fetch-hadith: {c} arabic has {len(A)} numbers and english {len(E)}, "
              f"{len(set(A) ^ set(E))} of them unmatched — refusing to join", file=sys.stderr)
        sys.exit(1)

    B = {}
    bn_dropped = 0
    if bn is not None:
        raw = {key(h): h for h in bn["hadiths"]}
        overlap = len(set(raw) & set(A))
        if overlap < 0.95 * len(A):
            # A Bengali edition numbered differently from the Arabic cannot be
            # placed beside it. Better no Bangla than the wrong Bangla.
            print(f"fetch-hadith: {c} bengali matches only {overlap} of {len(A)} numbers — "
                  f"dropping bengali for this collection", file=sys.stderr)
        else:
            for k, h in raw.items():
                if k not in A:
                    continue
                text = (h.get("text") or "").strip()
                # 0.8% of the Bengali entries are the chapter heading in Arabic
                # rather than a translation (Bukhari 6306 is one). An entry with
                # no Bengali script in it is not a Bengali translation, and
                # showing it as one would be a lie the reader cannot catch.
                if not BENGALI.search(text):
                    bn_dropped += 1
                    continue
                B[k] = text

    sections = {str(k): v for k, v in (en.get("metadata", {}).get("sections") or {}).items() if v}
    graded = 0
    with open(f"{out}/{c}.jsonl", "w", encoding="utf-8") as f:
        for k in sorted(A, key=number_order):
            a, e = A[k], E[k]
            grades = [{"by": g.get("name", "").strip(), "grade": g.get("grade", "").strip()}
                      for g in (e.get("grades") or []) if g.get("name") and g.get("grade")]
            if grades:
                graded += 1
            ref = e.get("reference") or {}
            row = {"n": k, "ar": (a.get("text") or "").strip(), "en": (e.get("text") or "").strip()}
            if k in B:
                row["bn"] = B[k]
            if grades:
                row["grades"] = grades
            if ref.get("book") is not None:
                row["book"] = ref["book"]
            if ref.get("hadith") is not None:
                row["in_book"] = ref["hadith"]
            f.write(json.dumps(row, ensure_ascii=False, separators=(",", ":")) + "\n")

    manifest.append({
        "slug": c,
        "name": (en.get("metadata", {}) or {}).get("name") or c,
        "hadiths": len(A),
        "bengali": len(B),
        "bengali_untranslated": bn_dropped,
        "graded": graded,
        "sections": sections,
    })
    print(f"fetch-hadith: {c}: {len(A)} hadiths, {len(B)} bengali, {graded} graded", file=sys.stderr)

json.dump({
    "source": {
        "url": f"github.com/fawazahmed0/hadith-api@{sha[:12]}",
        "licence": "Unlicense",
        "numbering": "sunnah.com",
        "verify": "https://sunnah.com/<collection>:<number>",
        "collections": len(manifest),
        "hadiths": sum(m["hadiths"] for m in manifest),
    },
    "collections": manifest,
}, open(f"{out}/collections.json", "w", encoding="utf-8"), ensure_ascii=False, separators=(",", ":"))
PY
