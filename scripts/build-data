#!/usr/bin/env bash
# Build deen's Quran, word and dua files from a directory of pinned sources.
# Nothing here reaches the network; the install hands over a sources tree whose
# every file it has already checked against that tree's own sha256 manifest.
#
#   scripts/build-data <sources> <output directory>
#
# It writes quran.json, words.json and duas.json into the output directory,
# each ayah and word with its Bangla pronunciation from `deen pron`, run as
# DEEN_BIN (deen on PATH when unset), from these files of the sources tree:
#
#   quran/uthmani.txt               Tanzil Uthmani, "surah|ayah|text"
#   quran/tajweed.json              cpfair's tajweed spans over that exact file
#   quran/ben-abubakrzakaria.json   the Bangla meaning, fawazahmed0's layout
#   quran/en.sahih.json             the English meaning and the surahs, alquran.cloud's layout
#   surahs-bn.toml                  each surah's Bangla name, [surahs] 94 = "সূরা আশ-শারহ"
#   words/words.json                the per-word file scripts/fetch-words built, kept as built
#   words/quranwbw-bn.json          each word's Bangla meaning, "s" -> "a" -> [[word, ...]]
#   duas/hisn.json                  the dua file scripts/fetch-duas built, kept as built
#
# THE ARABIC IS TANZIL'S, NOT alquran.cloud's, and the choice is forced by the
# two things that index into it:
#
#   * The tajweed annotations are codepoint offsets into ONE pinned Tanzil file
#     (cpfair's README: use any other text and you must rebuild from scratch).
#     Against that file 15,985 annotations land correctly; against
#     alquran.cloud's quran-uthmani only 53% do, and the drift is variable
#     WITHIN an ayah, so no constant shift recovers it.
#
#   * The word-by-word audio CDN is indexed by word position. alquran.cloud's
#     text carries waqf marks (ۛ) as separate whitespace-delimited tokens —
#     82,456 "words" against Tanzil's 77,878 — so its split runs ahead of the
#     audio on the 2,719 ayat that have them. Verified: 2:2 is seven words on
#     the CDN (002_002_008 is a 404) and nine in alquran.cloud's text.
#
# The meanings are joined on (surah, ayah) rather than by position, so a
# numbering difference fails loudly instead of shifting a meaning by one ayah.
set -euo pipefail

src=${1:?usage: build-data <sources> <output directory>}
out=${2:?usage: build-data <sources> <output directory>}
mkdir -p "$out"
tmp=$(mktemp -d -p "$out" .build-XXXXXX)
trap 'rm -rf "$tmp"' EXIT

python3 -I - "$src" "$tmp" <<'PY'
import json, re, sys, collections, tomllib
src, tmp = sys.argv[1], sys.argv[2]

def stop(msg):
    print(f"build-data: {msg}", file=sys.stderr)
    sys.exit(1)

# Tanzil ships "surah|ayah|text" plus a licence footer; the isdigit guard drops
# the footer without having to know how many lines it is.
arabic = {}
for line in open(f"{src}/quran/uthmani.txt", encoding="utf-8"):
    p = line.rstrip("\r\n").split("|")
    if len(p) == 3 and p[0].isdigit():
        arabic[(int(p[0]), int(p[1]))] = p[2]
if len(arabic) != 6236:
    stop(f"the Tanzil text has {len(arabic)} ayat, expected 6236")

# THE BASMALA IS A PREFIX ON EVERY FIRST AYAH AND IT IS NOT PART OF THE AYAH.
#
# Tanzil glues it onto ayah 1 of every surah but Al-Fatiha (where it IS ayah 1)
# and At-Tawbah (which has none). Left in, three things break at once: the
# reader shows a Basmala inside Al-Ikhlas 1, the word-by-word audio runs four
# words ahead of the text for 112 surahs, and the recitation checker marks four
# words missing from every correctly recited opening ayah. Verified against the
# CDN: 112:1 is four words there (112_001_005 is a 404) and eight here.
#
# Stripped by WORD COUNT, not by matching the text. Surahs 95 and 97 spell it
# بِّسْمِ, with a shadda the other 110 do not have, so a literal comparison
# silently leaves the Basmala in exactly two surahs — the kind of bug that
# hides for years because nobody reads At-Tin looking for it.
BASMALA_WORDS = 4
basmala = arabic[(1, 1)]
basmala_shift = {}
for s in range(2, 115):
    if s == 9:
        continue
    text = arabic[(s, 1)]
    parts = text.split(" ")
    if len(parts) <= BASMALA_WORDS:
        stop(f"surah {s} ayah 1 is only {len(parts)} words")
    cut = len(" ".join(parts[:BASMALA_WORDS])) + 1
    arabic[(s, 1)] = text[cut:]
    basmala_shift[(s, 1)] = cut

# Zakaria's meaning carries his footnote marks inline, " [১]" and a few typed
# loosely: "[১।]" and "[২।" with the stop inside, "[‌১]" with a zero-width
# non-joiner, "[ ৩]" with a space. The notes themselves are not in the source,
# so a mark only says that a note exists somewhere else. Any mark these rules
# miss stops the build, rather than being drawn as a stray bracket.
DIGITS = "[০-৯]+"
GAP = r"[\s‌]*"
MARK = re.compile(rf"\s*\[{GAP}{DIGITS}{GAP}\]")
MARK_STOP = re.compile(rf"\s*\[{GAP}{DIGITS}{GAP}(।)\]?")
LEFT = re.compile(rf"\[{GAP}[০-৯0-9]")
def meaning(text):
    text = MARK_STOP.sub(r"\1", MARK.sub("", text))
    return text.replace("<b>", "").replace("</b>", "")

bn = {}
for a in json.load(open(f"{src}/quran/ben-abubakrzakaria.json", encoding="utf-8"))["quran"]:
    ref = (a["chapter"], a["verse"])
    bn[ref] = meaning(a["text"])
    if LEFT.search(bn[ref]) or "<" in bn[ref]:
        stop(f"{ref[0]}:{ref[1]}'s Bangla still holds a footnote mark or a tag after stripping: {bn[ref]!r}")

english = json.load(open(f"{src}/quran/en.sahih.json", encoding="utf-8"))["data"]["surahs"]
en = {(s["number"], a["numberInSurah"]): a["text"] for s in english for a in s["ayahs"]}
for name, t in (("Bangla", bn), ("English", en)):
    if set(t) != set(arabic):
        stop(f"the {name} meaning covers {len(t)} ayat, {len(set(t) ^ set(arabic))} of them not the Tanzil text's")

# Tajweed spans, compacted: a rule dictionary plus [start, end, rule_index]
# triples. The raw file is 5.4 MB of repeated rule names.
rules, rule_id = [], {}
tajweed = collections.defaultdict(list)
for entry in json.load(open(f"{src}/quran/tajweed.json", encoding="utf-8")):
    ref = (entry["surah"], entry["ayah"])
    # The annotations were generated against the text WITH the Basmala, so
    # every offset on a first ayah moves back by what was cut from it.
    shift = basmala_shift.get(ref, 0)
    for ann in entry["annotations"]:
        start, end = ann["start"] - shift, ann["end"] - shift
        # An annotation that lived inside the Basmala has nothing left to point
        # at. (In this data there are none — the generator does not annotate
        # the prefix — but a silently negative offset would colour the wrong
        # letters rather than fail.)
        if end <= 0:
            continue
        start = max(0, start)
        r = ann["rule"]
        if r not in rule_id:
            rule_id[r] = len(rules)
            rules.append(r)
        tajweed[ref].append([start, end, rule_id[r]])

try:
    names = tomllib.load(open(f"{src}/surahs-bn.toml", "rb")).get("surahs", {})
except FileNotFoundError:
    stop("the sources have no surahs-bn.toml, so they are older than this deen")
for n in range(1, 115):
    if not str(names.get(str(n), "")).strip():
        stop(f"surahs-bn.toml has no Bangla name for surah {n}")

surahs = [{
    "n": m["number"], "ar": m["name"], "en": m["englishName"],
    "tr": m["englishNameTranslation"], "bn": names[str(m["number"])],
    "count": len(m["ayahs"]), "type": m["revelationType"],
} for m in sorted(english, key=lambda m: m["number"])]

ayahs = [{
    "s": s, "a": a, "ar": ar, "bn": bn[(s, a)], "en": en[(s, a)],
    "taj": tajweed.get((s, a), []),
} for (s, a), ar in sorted(arabic.items())]

# The Basmala travels separately, so a reader can head each surah with it
# without it being inside anyone's ayah 1.
with open(f"{tmp}/quran.json", "w", encoding="utf-8") as f:
    json.dump({"surahs": surahs, "basmala": basmala, "rules": rules, "ayahs": ayahs},
              f, ensure_ascii=False, separators=(",", ":"))

# Each word's Bangla meaning joins words.json by position, so the two have to
# split every ayah into the same number of words; one that differs stops the
# build rather than putting a meaning under the wrong word, and so does a word
# whose meaning is blank.
words = json.load(open(f"{src}/words/words.json", encoding="utf-8"))
wbw = json.load(open(f"{src}/words/quranwbw-bn.json", encoding="utf-8"))
for ref, ayah in words.items():
    s, a = ref.split(":")
    got = (wbw.get(s, {}).get(a) or [[]])[0]
    if len(got) != len(ayah["words"]):
        stop(f"{ref} has {len(ayah['words'])} words in words.json and {len(got)} Bangla meanings")
    for w, m in zip(ayah["words"], got):
        if not m.strip():
            stop(f"{ref} has a word with no Bangla meaning")
        w["bn"] = m
with open(f"{tmp}/words.json", "w", encoding="utf-8") as f:
    json.dump(words, f, ensure_ascii=False, separators=(",", ":"))
PY

# Hisn al-Muslim is kept as scripts/fetch-duas built it, since one of the two
# copies that build checked against is gone; it only has to parse.
python3 -I -c 'import json, sys; json.load(open(sys.argv[1], encoding="utf-8"))' "$src/duas/hisn.json" \
  || { echo "build-data: duas/hisn.json is not JSON" >&2; exit 1; }
cp "$src/duas/hisn.json" "$tmp/duas.json"

# The pronunciation is deen's own engine, so it runs on the files above before
# any of them lands; a code point it has no rule for stops the build here.
"${DEEN_BIN:-deen}" pron "$tmp" >/dev/null || { echo "build-data: deen pron failed" >&2; exit 1; }

# Each file lands by a rename, so a reader never opens one half written.
for f in quran words duas; do
  mv -f "$tmp/$f.json" "$out/$f.json"
done
