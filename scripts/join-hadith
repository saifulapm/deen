#!/usr/bin/env python3
# Join the deen-data snapshot's hadith editions into deen's corpus.
#
#   join-hadith <deen-data dir> <output dir> <format> "<collections>"
#
# Reads hadith/<lang>-<collection>.min.json for ara, eng and ben, writes one
# <collection>.jsonl per collection, a copy of the snapshot's manifest.toml,
# and collections.json last, so a reader that finds collections.json finds
# every collection beside it. <format> is deen's number for what this script
# writes; `deen hadith status` reads a corpus of another format, or from
# another manifest, as missing. `deen hadith fetch` embeds this file and pipes
# it to `python3 -I -`, and reads the line it prints per collection.

import collections as counting, json, os, re, shutil, sys, tomllib

src, out, fmt, collections = sys.argv[1], sys.argv[2], int(sys.argv[3]), sys.argv[4].split()

# The upstream commit deen-data's manifest.toml names for the editions.
SHA = "df57907be35291c91ad6a6691180e22ca9920784"

# The Bangla names of the collections and their books, keyed by book number.
NAMES = tomllib.load(open(f"{src}/hadith-books-bn.toml", "rb"))
# Book 0 holds the narrations filed under no titled book; the names file may
# name it, as it does Nasai's.
OTHERS = "অন্যান্য"

# A rebuild cut short must not leave the old collections.json over new files.
if os.path.exists(f"{out}/collections.json"):
    os.remove(f"{out}/collections.json")

BENGALI = re.compile("[ঀ-৿]")

def load(lang, c):
    path = f"{src}/hadith/{lang}-{c}.min.json"
    if not os.path.exists(path) or os.path.getsize(path) == 0:
        return None
    return json.load(open(path, encoding="utf-8"))

def key(h):
    # The number is a STRING because a few are fractional (402.2), the same way
    # a dua id is a string because a few are lettered (75a). It is a citation,
    # not an index, and parsing it as a number loses the ones that matter.
    n = h.get("hadithnumber")
    return ("%s" % n).rstrip("0").rstrip(".") if isinstance(n, float) and n.is_integer() else str(n)

BN_DIGITS = str.maketrans("0123456789", "০১২৩৪৫৬৭৮৯")
DIGIT = re.compile("[0-9০-৯]")
# Malik's Bangla edition opens with its own number for the narration,
# `রেওয়ায়ত ১০৬. `, which is neither sunnah.com's nor the book's.
YA = "(?:\u09DF|\u09AF\u09BC)"
MALIK_NUMBER = re.compile(rf"^\s*রেও{YA}া{YA}া?ত\s*[০-৯]+\s*\.?\s+")
SPOKEN = re.compile("বলেন|বলেছেন|বললেন|বলতে|বর্ণিত|বর্ণনা|[\u0600-\u06ff]")
NARRATOR_DOTS = re.compile(r"\((রহ[ঃ.:]?|রাহ[ঃ.:]?|রহিঃ|রহিমাহুম[াু]ল্লাহ)\)\s*\.{5}")
PUBLISHER = re.compile("প্রকাশনী|ফাউন্ডেশন|সেন্টার")
NUMBERS_ONLY = re.compile(r"[0-9০-৯/,;:ঃ.\-–ও\s]*")

def reference(m):
    """A bracket or parenthesis the reader does not need: the editions' own
    cross-references, publisher numbers and footnote marks. Brackets the
    translator wrote into the narration, and parentheses like `(২ বার)` or
    `(রাঃ)`, are the text and stay."""
    inside = m.group(0)[1:-1].strip()
    if m.group(0)[0] == "[":
        drop = DIGIT.search(inside) or inside.endswith("ঃ")
    else:
        drop = (PUBLISHER.search(inside) or (DIGIT.search(inside) and NUMBERS_ONLY.fullmatch(inside))
                or (DIGIT.search(inside) and re.search("হাঃ|দ্রষ্টব্য", inside))
                or (DIGIT.match(inside) and ";" in inside))
    return " " if drop else m.group(0)

def unmatched_brackets_gone(t):
    """A `]` the edition left with no `[`, or the reverse, goes."""
    open_at, gone = [], set()
    for i, ch in enumerate(t):
        if ch == "[":
            open_at.append(i)
        elif ch == "]":
            if open_at:
                open_at.pop()
            else:
                gone.add(i)
    gone.update(open_at)
    return "".join(" " if i in gone else ch for i, ch in enumerate(t))

def clean(text, n):
    """The narration alone out of a Bangla edition's entry (ruling 1Q6R0T2W).

    The editions prefix the chapter's heading and the narration's number, open
    with a stub of the chain and close with a note on another chain, and carry
    the publishers' numbers and cross-references inline. Grade remarks such as
    হাসান গারীব are the text's own and stay."""
    t = text.strip()
    # The heading ends at the narration's own number, `৬১১৪. `; a different
    # number in the text is never a heading's end.
    marker = re.search(r"(?:^|(?<=\s))" + re.escape(n.translate(BN_DIGITS)) + r"\s*\.\s", t)
    if marker:
        t = t[marker.end():]
    else:
        t = MALIK_NUMBER.sub("", t, count=1)
    t = t.lstrip("। \n")
    # A chain stub is a list of narrators before `.....` in the first sentence;
    # dots after someone speaks or narrates leave out a passage instead.
    stub = t.find(".....")
    if stub >= 0 and (t.find("।") < 0 or stub < t.find("।")) and not SPOKEN.search(
            re.sub(r"\([^()]*\)|\[[^\[\]]*\]", "", t[:stub])):
        t = t[stub:].lstrip(". ")
    t = re.sub(r"\[[^\[\]]*\]|\([^()]*\)", reference, t)
    t = unmatched_brackets_gone(t)
    # A chain note is the last sentence, a narrator then `.....`; the same
    # dots elsewhere in the narration mark a passage left out, and stay.
    t = t.rstrip()
    last = max(t.rfind(p, 0, len(t) - 1) for p in "।?!")
    if last >= 0 and NARRATOR_DOTS.search(t[last:]):
        t = t[:last + 1]
    t = re.sub(r"\s+", " ", t)
    t = re.sub(r" (?=[।,?!])", "", t)
    return t.strip()

def number_order(k):
    """File order is the book's order, so a reader scrolling a collection is
    walking it rather than reading a hash. `402.2` sorts after `402`."""
    try:
        return (0, float(k), "")
    except ValueError:
        return (1, 0.0, k)

manifest = []
for c in collections:
    ar, en, bn = load("ara", c), load("eng", c), load("ben", c)
    if ar is None or en is None:
        # A skipped collection must never be a warning nobody reads.
        print(f"fetch-hadith: {c} is missing its Arabic or English edition", file=sys.stderr)
        sys.exit(1)

    A = {key(h): h for h in ar["hadiths"]}
    E = {key(h): h for h in en["hadiths"]}
    if set(A) != set(E):
        # THE JOIN KEY HAS TO BE THE SAME KEY. Two editions that disagree about
        # which numbers exist would pair an Arabic hadith with somebody else's
        # translation, and nothing downstream could tell.
        print(f"fetch-hadith: {c} arabic has {len(A)} numbers and english {len(E)}, "
              f"{len(set(A) ^ set(E))} of them unmatched — refusing to join", file=sys.stderr)
        sys.exit(1)

    B = {}
    bn_dropped = 0
    if bn is not None:
        raw = {key(h): h for h in bn["hadiths"]}
        overlap = len(set(raw) & set(A))
        if overlap < 0.95 * len(A):
            # A Bengali edition numbered differently from the Arabic cannot be
            # placed beside it. Better no Bangla than the wrong Bangla.
            print(f"fetch-hadith: {c} bengali matches only {overlap} of {len(A)} numbers — "
                  f"dropping bengali for this collection", file=sys.stderr)
        else:
            for k, h in raw.items():
                if k not in A:
                    continue
                text = (h.get("text") or "").strip()
                # 0.8% of the Bengali entries are the chapter heading in Arabic
                # rather than a translation (Bukhari 6306 is one). An entry with
                # no Bengali script in it is not a Bengali translation, and
                # showing it as one would be a lie the reader cannot catch.
                if not BENGALI.search(text):
                    bn_dropped += 1
                    continue
                B[k] = text

    sections = {str(k): v for k, v in (en.get("metadata", {}).get("sections") or {}).items() if v}
    graded = 0
    counts = counting.Counter()
    with open(f"{out}/{c}.jsonl", "w", encoding="utf-8") as f:
        for k in sorted(A, key=number_order):
            a, e = A[k], E[k]
            grades = [{"by": g.get("name", "").strip(), "grade": g.get("grade", "").strip()}
                      for g in (e.get("grades") or []) if g.get("name") and g.get("grade")]
            if grades:
                graded += 1
            ref = e.get("reference") or {}
            row = {"n": k, "ar": (a.get("text") or "").strip(), "en": (e.get("text") or "").strip()}
            if k in B:
                bn = clean(B[k], k)
                # The cleaned text first: Bangla search reads the field after
                # `en` up to the next key (src/hadith.rs field_span).
                if bn:
                    row["bn"] = bn
                row["bn_raw"] = B[k]
            if grades:
                row["grades"] = grades
            if ref.get("book") is not None:
                row["book"] = ref["book"]
            if ref.get("hadith") is not None:
                row["in_book"] = ref["hadith"]
            # A narration empty in every language is kept, so a line's position
            # stays its index, but no book lists or counts it.
            if row["ar"] or row["en"] or k in B:
                counts[row.get("book", 0)] += 1
            f.write(json.dumps(row, ensure_ascii=False, separators=(",", ":")) + "\n")

    names = NAMES.get("books", {}).get(c, {})
    books = [{"n": n, "bn": names.get(str(n)) or (OTHERS if n == 0 else ""), "en": sections.get(str(n), ""), "count": counts[n]}
             for n in sorted(counts, key=lambda n: (n == 0, n))]
    manifest.append({
        "slug": c,
        "name": (en.get("metadata", {}) or {}).get("name") or c,
        "bn": NAMES.get("collections", {}).get(c, ""),
        "count": sum(counts.values()),
        "books": books,
        "hadiths": len(A),
        "bengali": len(B),
        "bengali_untranslated": bn_dropped,
        "graded": graded,
        "sections": sections,
    })
    print(f"fetch-hadith: {c}: {len(A)} hadiths, {len(B)} bengali, {graded} graded", file=sys.stderr)

shutil.copyfile(f"{src}/manifest.toml", f"{out}/manifest.toml")
json.dump({
    "source": {
        "url": f"github.com/fawazahmed0/hadith-api@{SHA[:12]}",
        "format": fmt,
        "licence": "Unlicense",
        "numbering": "sunnah.com",
        "verify": "https://sunnah.com/<collection>:<number>",
        "collections": len(manifest),
        "hadiths": sum(m["hadiths"] for m in manifest),
    },
    "collections": manifest,
}, open(f"{out}/collections.json", "w", encoding="utf-8"), ensure_ascii=False, separators=(",", ":"))
